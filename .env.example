# Copy to .env.local and fill in. NEVER commit real values.

# Postgres
DATABASE_URL=postgres://wtr:wtr@127.0.0.1:5432/wtr

# Operator wallet (Aeneid testnet only — never a mainnet key)
WTR_WALLET_PRIVATE_KEY=

# Trace (staging). BLOCKED: requires a WTR provider scope + staging API key (goal.md §11 Q1).
WTR_TRACE_BASE_URL=https://staging-api.storyprotocol.net
WTR_TRACE_API_KEY=
WTR_TRACE_PROVIDER=wtr

# Story Aeneid. Defaults are the goal.md §5.2 values; override only for a local fork.
WTR_RPC_URL=https://testnet.rpc.story.foundation
WTR_EXPLORER_URL=https://testnet.explorer.story.foundation

# Story-API REST base URL used by the CDR SDK to read DKG partial decryptions.
WTR_CDR_API_URL=http://127.0.0.1:1317

# WTR's own SPG NFT collection, printed by `npm run bootstrap`.
WTR_SPG_NFT_CONTRACT=

# IPFS node used for encrypted media and content-addressed JSON documents.
WTR_IPFS_API_URL=http://127.0.0.1:5001
WTR_IPFS_GATEWAY_URL=https://ipfs.io/ipfs
WTR_PIL_TERMS_BASE_URI=https://ipfs.io/ipfs

# debug | info | warn | error
WTR_LOG_LEVEL=info

# HMAC key for wallet session cookies (any long random string).
# Unset = single-creator dev mode with no login.
WTR_SESSION_SECRET=
